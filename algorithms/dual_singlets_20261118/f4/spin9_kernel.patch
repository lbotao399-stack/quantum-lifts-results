+// Exact orthogonal multiplicities supplied by the independent partition character.
+using MultiplicityPattern = std::vector<std::pair<int, int>>;
+static std::map<MultiplicityPattern, i64> rank_four_dimensions;
+static void read_rank_four_dimensions() {
+  const char *path = std::getenv("N4_B4_PATTERNS");
+  if (!path) throw std::runtime_error("Missing SO9 character table");
+  std::ifstream input(path);
+  std::string gauge;
+  if (!(input >> gauge) || gauge != GNAME) throw std::runtime_error("Wrong character table");
+  int n;
+  while (input >> n) {
+    MultiplicityPattern pattern;
+    for (int i = 0; i < n; ++i) {
+      int count, odd;
+      if (!(input >> count >> odd) || count <= 0 || odd < 0 || odd > 1)
+        throw std::runtime_error("Invalid character pattern");
+      pattern.emplace_back(count, odd);
+    }
+    i64 dimension;
+    if (!(input >> dimension) || dimension < 0 || !rank_four_dimensions.emplace(pattern, dimension).second)
+      throw std::runtime_error("Invalid character dimension");
+  }
+  if (!input.eof()) throw std::runtime_error("Unreadable character table");
+}
